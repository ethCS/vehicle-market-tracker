# FB client SDK
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=vehicle-market-tracker.firebaseapp.com
NEXT_PUBLIC_FB_PROJECT_ID=vehicle-market-tracker
NEXT_PUBLIC_FB_STORAGE_BUCKET=vehicle-market-tracker.appspot.com
NEXT_PUBLIC_FB_MESSAGING_SENDER_ID=211740032292
NEXT_PUBLIC_FB_APP_ID=

# FB Admin SDK (server-side; use service account JSON)
FB_ADMIN_PROJECT_ID=vehicle-market-tracker
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Google Cloud
GCLOUD_PROJECT=vehicle-market-tracker
GCLOUD_PROJECT_NUMBER=211740032292
PUBSUB_TOPIC_INGEST=vehicle-ingest
PUBSUB_TOPIC_PRICES=price-ingest

# MarketCheck pricing API
MARKETCHECK_API_KEY=
MARKETCHECK_CLIENT_SECRET=
MARKETCHECK_COUNTRY=us
MARKETCHECK_ROWS=25

# RapidAPI VIN decoding for vehicle specs
RAPIDAPI_KEY=
RAPIDAPI_HOST=car-api2.p.rapidapi.com

# Internal security: shared secret for Pub/Sub push endpoint
INGEST_SECRET=replace-with-random-string
